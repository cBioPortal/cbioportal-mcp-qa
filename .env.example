# LibreChat Agents API key (Settings → Agent API Keys on beta.chat.cbioportal.org)
LIBRECHAT_API_KEY=

# Langfuse, for per-answer tool-call stats (optional)
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Judge on Bedrock (us. inference profiles only; global. is blocked by MSK policy)
AWS_PROFILE=cdsi-imagine-490004633549
AWS_REGION=us-east-1
JUDGE_MODEL=us.anthropic.claude-sonnet-4-6

# Chromium for rendering navigation links (default: Playwright's own, installed with `uv run playwright install chromium`)
# CHROMIUM_PATH=

# --runner claude-code: the MCP servers (port-forwarded prod services by default), the kubectl context used to
# read the agent's prompt and image digests, and the Claude home whose subscription pays for the answers.
# CLAUDE_AI_DATABASE_CONNECTOR=claude.ai cBioPortal MCP   # database MCP via this claude.ai connector (see `claude mcp list`)
# DATABASE_MCP_URL=http://localhost:18080/db/mcp            # …or a port-forward, when no connector is set
# NAVIGATOR_MCP_URL=https://mcp.cbioportal.org/navigator/mcp
# KUBE_CONTEXT=<kubectl context of the cluster running the agent; default: current context>
# CLAUDE_CONFIG_DIR=~/.claude
