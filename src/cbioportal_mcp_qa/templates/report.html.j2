{%- macro mclass(key) %}m-{{ key | replace('.', '-') }}{% endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>cBioPortalChat benchmark {{ run.run_id }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<main>
<p class="meta"><a href="../index.html">← All runs</a></p>
<h1>cBioPortalChat benchmark · {{ run.run_id }}</h1>
<p class="meta">
  {{ n_questions }} questions ({{ n_gradeable }} with a reference answer, link or rubric){% if run.repeats > 1 %}, {{ run.repeats }} repeats each{% endif %} ·
  target <a href="{{ target.url if target else '#' }}">{{ target.url if target else run.target }}</a>
  (agent <code>{{ target.agent_id if target else '' }}</code>) ·
  judge <code>{{ run.judge_model }}</code>{% if judge_cost is not none %} ({{ judge_cost | usd }}){% endif %}
</p>
<p class="meta">
  runner <strong>{{ run.runner or 'agents-api' }}</strong>{% if run.runner == 'claude-code' %} (headless Claude Code with the agent's prompt and MCP servers — compare with other claude-code runs, not with agents-api runs){% endif %}
  {%- if run.agent_prompt and run.agent_prompt.sha256 %} · agent prompt <code>{{ run.agent_prompt.sha256 }}</code> ({{ run.agent_prompt.chars }} chars){% endif %}
</p>
{% if run.versions %}
<p class="meta versions">
  {%- set v = run.versions %}
  {%- if v.cbioportal_api and v.cbioportal_api.portal_version %}cBioPortal <code>{{ v.cbioportal_api.portal_version }}</code> (DB schema {{ v.cbioportal_api.db_schema_version }}, {{ v.cbioportal_api.gene_table_version }}) · {% endif %}
  {%- if v.cbioportal_mcp and v.cbioportal_mcp.version %}cbioportal-mcp <code>{{ v.cbioportal_mcp.version }}</code>{% if v.image_digests and v.image_digests.cbioportal_mcp %} ({{ v.image_digests.cbioportal_mcp }}){% endif %} · {% endif %}
  {%- if v.cbioportal_navigator and v.cbioportal_navigator.version %}navigator <code>{{ v.cbioportal_navigator.version }}</code>{% if v.image_digests and v.image_digests.cbioportal_navigator %} ({{ v.image_digests.cbioportal_navigator }}){% endif %} · {% endif %}
  {%- if v.clickhouse and v.clickhouse.database %}ClickHouse <code>{{ v.clickhouse.database }}</code> built {{ v.clickhouse.built }} UTC{% endif %}
  {%- if v.claude_code and v.claude_code is string %} · {{ v.claude_code }}{% endif %}
  {%- if v.librechat and v.librechat is string %} · LibreChat <code>{{ v.librechat.split(':')[-1] }}</code>{% endif %}
</p>
{% endif %}

<h2>Headline</h2>
<div class="tiles">
{% for m in models %}
  <section class="card tile {{ mclass(m.key) }}">
    <h3><span class="swatch model"></span>{{ m.label }}</h3>
    <div class="row"><span>Pass rate</span><span><span class="value">{{ m.pass_rate | pct }}</span>
      <span class="sub">of {{ m.graded }} graded</span></span></div>
    <div class="row"><span>Precision · coverage</span><span><span class="value">{{ m.precision | pct }}</span>
      <span class="sub">answered {{ m.coverage | pct }}</span></span></div>
    <div class="row"><span>Cost per correct answer</span><span><span class="value">{{ m.cost_per_pass | usd }}</span>
      <span class="sub">{{ m.cost_per_answer | usd }} per answer{% if not m.cost_complete %}*{% endif %}</span></span></div>
    <div class="row"><span>Median latency</span><span><span class="value">{{ m.median_latency | secs }}</span>
      <span class="sub">p90 {{ m.p90_latency | secs }}</span></span></div>
    <div class="row"><span>Tool errors</span><span><span class="value">{{ m.tool_error_rate | pct }}</span>
      <span class="sub">{{ m.tool_errors.values() | sum }} of {{ m.tool_calls.values() | sum }} calls{% if m.schema_errors %} · {{ m.schema_errors }} schema{% endif %}</span></span></div>
  </section>
{% endfor %}
</div>
<p class="note">Precision: pass rate on questions the model attempted. Coverage: share it attempted rather than declined.
  {% if run.runner == 'claude-code' %}Costs are what these tokens would cost at Anthropic list prices; this run was answered on a Claude subscription and billed nothing per token.{% else %}Costs are estimates at Anthropic list prices; Bedrock billing can differ.{% endif %}{% if models | selectattr('cost_complete', 'false') | list %}
  * Some answers had no cache read/write split and are costed as uncached input (an upper bound).{% endif %}</p>

<h2>Outcomes</h2>
<div class="card">
{% for m in models %}
  <div class="verdict-row {{ mclass(m.key) }}">
    <div class="name"><span class="swatch model"></span>{{ m.label }}</div>
    <div class="stack" role="img" aria-label="{{ m.label }} outcomes">
      {% for seg in m.outcome_segments() %}<span class="o-{{ seg.key }}" style="flex: {{ seg.count }}" title="{{ seg.label }}: {{ seg.count }} ({{ seg.pct | pct }})"></span>{% endfor %}
    </div>
    <div class="legend">
      {% for seg in m.outcome_segments() %}<span><span class="swatch o-{{ seg.key }}"></span>{{ seg.icon }} {{ seg.label }} <b>{{ seg.count }}</b> ({{ seg.pct | pct }})</span>{% endfor %}
    </div>
  </div>
{% endfor %}
</div>

{% if by_track %}
<h2>Pass rate by track</h2>
<div class="card">
  <div class="legend" style="margin-bottom:12px">
    {% for m in models %}<span class="{{ mclass(m.key) }}"><span class="swatch model"></span>{{ m.label }}</span>{% endfor %}
  </div>
  <div class="bars">
  {% for row in by_track %}
    <div class="label">{{ row.label }} <span class="sub">n={{ row.n }}</span></div>
    <div class="bar-pair">
      {% for m in models %}{% set v = row["values"][m.key] %}
      <div class="bar {{ mclass(m.key) }}{% if v is none %} none{% endif %}" title="{{ m.label }}: {{ v | pct }} pass">
        {% if v is not none %}<i style="width: {{ [v, 0.5] | max }}%"></i>{% endif %}<em>{{ v | pct }}</em>
      </div>
      {% endfor %}
    </div>
  {% endfor %}
  </div>
  <p class="note">Data: a fact from the data. Navigation: the right cBioPortal link or view. Analysis: comparisons, survival and statistics without invented numbers. Out of scope: declines clearly.</p>
</div>
{% endif %}

{% if by_category %}
<h2>Pass rate by category</h2>
<div class="card">
  <div class="legend" style="margin-bottom:12px">
    {% for m in models %}<span class="{{ mclass(m.key) }}"><span class="swatch model"></span>{{ m.label }}</span>{% endfor %}
  </div>
  <div class="bars">
  {% for row in by_category %}
    <div class="label">{{ row.category }} <span class="sub">n={{ row.n }}</span></div>
    <div class="bar-pair">
      {% for m in models %}{% set v = row["values"][m.key] %}
      <div class="bar {{ mclass(m.key) }}{% if v is none %} none{% endif %}" title="{{ m.label }}: {{ v | pct }} pass">
        {% if v is not none %}<i style="width: {{ [v, 0.5] | max }}%"></i>{% endif %}<em>{{ v | pct }}</em>
      </div>
      {% endfor %}
    </div>
  {% endfor %}
  </div>
  <p class="note">Topic of the question. Small categories (low n) swing a lot from run to run.</p>
</div>
{% endif %}

<h2>Tokens and cost</h2>
<div class="card table-wrap">
<table>
  <thead><tr><th>Model</th><th>Answers</th><th>Input tokens</th><th>of which cache read</th><th>cache write</th>
    <th>Output tokens</th><th>Input / answer</th><th>Est. cost</th><th>Per answer</th><th>Per correct answer</th></tr></thead>
  <tbody>
  {% for m in models %}
    <tr class="{{ mclass(m.key) }}"><td><span class="swatch model"></span>{{ m.label }}</td><td>{{ m.answers }}</td>
      <td>{{ m.prompt_tokens | num }}</td><td>{{ m.cache_read_tokens | num }}</td><td>{{ m.cache_write_tokens | num }}</td>
      <td>{{ m.completion_tokens | num }}</td><td>{{ ((m.prompt_tokens / m.answers) if m.answers else none) | num }}</td>
      <td>{{ m.cost | usd }}</td><td>{{ m.cost_per_answer | usd }}</td><td>{{ m.cost_per_pass | usd }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2>Latency and tool use</h2>
<div class="card table-wrap">
<table>
  <thead><tr><th>Model</th><th>Median latency</th><th>p90</th><th>Max</th><th>LLM calls / answer</th>
    <th>Tool calls / answer</th><th>Tool errors</th><th>Schema errors</th><th>Failed requests</th><th>Traced</th></tr></thead>
  <tbody>
  {% for m in models %}
    <tr class="{{ mclass(m.key) }}"><td><span class="swatch model"></span>{{ m.label }}</td>
      <td>{{ m.median_latency | secs }}</td><td>{{ m.p90_latency | secs }}</td><td>{{ ((m.latencies | max) if m.latencies else none) | secs }}</td>
      <td>{{ m.mean_llm_calls | num(1) }}</td><td>{{ m.mean_tool_calls | num(1) }}</td>
      <td{% if m.tool_errors %} class="bad"{% endif %}>{{ m.tool_errors.values() | sum }}</td>
      <td{% if m.schema_errors %} class="bad"{% endif %}>{{ m.schema_errors }}</td>
      <td{% if m.outcomes.error %} class="bad"{% endif %}>{{ m.outcomes.error }}</td>
      <td>{{ m.traced }} / {{ m.answers }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% if all_tools %}
<table style="margin-top:16px">
  <thead><tr><th>Tool</th>{% for m in models %}<th>{{ m.label }} calls</th><th>errors</th>{% endfor %}</tr></thead>
  <tbody>
  {% for t in all_tools %}
    <tr><td><code>{{ t }}</code></td>{% for m in models %}<td>{{ m.tool_calls[t] }}</td><td{% if m.tool_errors[t] %} class="bad"{% endif %}>{{ m.tool_errors[t] }}</td>{% endfor %}</tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
</div>

<h2>Objective checks</h2>
<div class="card table-wrap">
<table>
  <thead><tr><th>Model</th><th>Numeric check disagrees with judge</th><th>Answers with cBioPortal links</th><th>Links with unknown study ids</th></tr></thead>
  <tbody>
  {% for m in models %}
    <tr class="{{ mclass(m.key) }}"><td><span class="swatch model"></span>{{ m.label }}</td>
      <td{% if m.number_disagreements %} class="bad"{% endif %}>{{ m.number_disagreements }} of {{ m.number_checks }}</td>
      <td>{{ m.link_answers }}</td>
      <td{% if m.invalid_study_links %} class="bad"{% endif %}>{{ m.invalid_study_links }}</td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="note">Numeric check: when the reference is a single number, whether the answer contains it (within rounding). A disagreement with the judge usually means a stale reference or a judge mistake — worth a look.
  Unknown study ids suggest a hallucinated link.</p>
</div>

<h2>Questions</h2>
<div class="filters">
  <input type="search" id="q-filter" placeholder="Filter questions…" aria-label="Filter questions">
  <select id="q-track" aria-label="Track"><option value="">All tracks</option>{% for key, label in track_labels.items() %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select>
  <label><input type="checkbox" id="q-disagree"> Models disagree</label>
  <label><input type="checkbox" id="q-wrong"> Any fail or error</label>
</div>
{% for row in questions %}{% set q = row.question %}
{% set outcomes = [] %}{% for m in models %}{% for c in row.cells[m.key] %}{% set _ = outcomes.append(c.outcome) %}{% endfor %}{% endfor %}
<details class="q" data-text="{{ (q.question ~ ' ' ~ (q.category or q.type) ~ ' ' ~ q.study) | lower }}" data-track="{{ q.track or 'data' }}"
  data-disagree="{{ 1 if (outcomes | unique | list | length) > 1 else 0 }}"
  data-wrong="{{ 1 if ('fail' in outcomes or 'error' in outcomes or 'declined' in outcomes) else 0 }}">
  <summary>
    <span class="qid">#{{ q.id }}</span>
    <span class="qtext"><span class="type"><span class="track">{{ track_labels[q.track or 'data'] }}</span>{{ q.category or q.type }} · {{ q.study }}</span>{{ q.question }}</span>
    <span class="badges">
      {% for m in models %}{% for c in row.cells[m.key] %}
      <span class="badge {{ mclass(m.key) }} o-{{ c.outcome }}" title="{{ m.label }}{% if run.repeats > 1 %} run {{ c.repeat }}{% endif %}: {{ c.outcome_label }}">
        <span class="dot"></span><span class="icon">{{ c.outcome_icon }}</span>{{ c.latency | secs }}
      </span>
      {% endfor %}{% endfor %}
    </span>
  </summary>
  <div class="qbody">
    <dl class="ref">
      {% if q.expected_answer %}<dt>Reference answer{% if q.checked %} <span class="sub">(checked {{ q.checked }})</span>{% endif %}</dt><dd>{{ q.expected_answer }}</dd>{% endif %}
      {% if q.expected_links %}<dt>Expected links</dt><dd>{% for u in q.expected_links %}<a href="{{ u }}">{{ u }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>{% endif %}
      {% if q.notes %}<dt>Notes</dt><dd>{{ q.notes }}</dd>{% endif %}
      {% if q.source and q.source != 'curated' %}<dt>Source</dt><dd><a href="{{ q.source }}">{{ q.source }}</a></dd>{% endif %}
      {% if not (q.expected_answer or q.expected_links or q.notes) %}<dt>No reference</dt><dd>Add an expected answer, link or rubric to <code>input/questions.yaml</code> to grade this question.</dd>{% endif %}
    </dl>
    <div class="answers">
      {% for m in models %}{% for c in row.cells[m.key] %}
      <div class="answer {{ mclass(m.key) }}">
        <h4><span>{{ m.label }}{% if run.repeats > 1 %} · run {{ c.repeat }}{% endif %} · {{ c.outcome_icon }} {{ c.outcome_label }}</span>
          <span class="stats">{{ c.latency | secs }} · {{ c.tokens | num }} tok · {{ c.cost | usd }}{% if c.trace %} · {{ c.trace.llm_calls }} LLM / {{ c.trace.tool_calls | length }} tool calls {%- if c.trace.url %} · <a href="{{ c.trace.url }}">{{ 'trace' if c.trace.url.startswith('http') else 'transcript' }}</a>{% endif %}{% endif %}</span></h4>
        {% if c.error %}<div class="err">{{ c.error }}</div>{% else %}<pre>{{ c.answer }}</pre>{% endif %}
        {% if c.grade %}
        <div class="judge">
          {{ c.grade.rationale }}
          {% if c.number_disagreement %}<br><span class="err">Numeric check {{ 'found' if c.grade.number_match else 'did not find' }} the reference number — disagrees with the judge.</span>{% endif %}
          {% if c.grade.invalid_studies %}<br><span class="err">Unknown study ids in links: {{ c.grade.invalid_studies | join(', ') }}</span>{% endif %}
        </div>
        {% endif %}
        {% if c.renders %}<div class="shots">{% for rd in c.renders %}
          {% if rd.ok %}<a href="{{ rd.screenshot }}" title="{{ rd.url }}"><img src="{{ rd.screenshot }}" alt="Screenshot of {{ rd.url }}" loading="lazy"></a>
          {% else %}<div class="err">Link failed to open: {{ rd.error }}</div>{% endif %}
        {% endfor %}</div>{% endif %}
        {% for e in c.tool_errors %}<div class="err">Tool error in <code>{{ e.name }}</code>: {{ e.error }}</div>{% endfor %}
      </div>
      {% endfor %}{% endfor %}
    </div>
  </div>
</details>
{% endfor %}
</main>
<script>
(() => {
  const text = document.getElementById("q-filter");
  const track = document.getElementById("q-track");
  const disagree = document.getElementById("q-disagree");
  const wrong = document.getElementById("q-wrong");
  const rows = [...document.querySelectorAll("details.q")];
  const apply = () => {
    const needle = text.value.trim().toLowerCase();
    for (const row of rows) {
      const hide = (needle && !row.dataset.text.includes(needle))
        || (track.value && row.dataset.track !== track.value)
        || (disagree.checked && row.dataset.disagree !== "1")
        || (wrong.checked && row.dataset.wrong !== "1");
      row.classList.toggle("hidden", hide);
    }
  };
  [text, track, disagree, wrong].forEach((el) => el.addEventListener("input", apply));
})();
</script>
</body>
</html>
