<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>cBioPortalChat test sets</title>
{% include "_style.html.j2" %}
<style>
nav.pages { display: flex; gap: 16px; margin-bottom: 8px; font-size: 14px; }
nav.pages .current { font-weight: 600; }
table.sets td { vertical-align: top; text-align: left; }
table.sets th { text-align: left; }
table.sets td.purpose { min-width: 360px; white-space: normal; line-height: 1.45; }
@media (max-width: 640px) { table.sets .purpose { display: none; } table.sets code { word-break: break-all; } }
.counts { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 8px 0 0; font-size: 13px; color: var(--ink-2); }
.counts strong { color: var(--ink); font-weight: 600; }
pre.run { margin: 8px 0 0; font-size: 12px; overflow-x: auto; }
.muted { color: var(--muted); }
</style>
</head>
<body>
<main>
<nav class="pages"><a href="index.html">Benchmark results</a><span class="current">Test sets</span></nav>
<h1>cBioPortalChat test sets</h1>
<p class="meta">Each questions file is a separate test set with its own purpose. A run asks every question in one set; its results are on the <a href="index.html">results page</a>, one table per set.</p>

<div class="card table-wrap" style="margin-top:20px">
<table class="sets">
  <thead><tr><th>Set</th><th>Questions</th><th class="purpose">Purpose</th><th>Runs</th></tr></thead>
  <tbody>
  {% for qs in question_sets %}
    <tr>
      <td><a href="#{{ qs.anchor }}"><strong>{{ qs.title }}</strong></a><br><a href="{{ qs.url }}"><code>{{ qs.file }}</code></a></td>
      <td>{{ qs.n_questions if qs.n_questions is not none else '–' }}</td>
      <td class="purpose">{{ qs.purpose }}</td>
      <td>{% if qs.runs %}<a href="index.html#runs-{{ qs.anchor }}">{{ qs.runs | length }}</a>{% else %}0{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2>Questions</h2>
<div class="filters">
  <input type="search" id="q-filter" placeholder="Filter questions…" aria-label="Filter questions">
  <select id="q-set" aria-label="Test set"><option value="">All sets</option>{% for qs in question_sets %}<option value="{{ qs.anchor }}">{{ qs.title }}</option>{% endfor %}</select>
  <select id="q-track" aria-label="Track"><option value="">All tracks</option>{% for key, label in track_labels.items() %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select>
</div>

{% for qs in question_sets %}
<section class="set" data-set="{{ qs.anchor }}">
<h2 id="{{ qs.anchor }}">{{ qs.title }}</h2>
<p class="meta">{{ qs.purpose }}</p>
<p class="meta">Questions: <a href="{{ qs.url }}"><code>{{ qs.file }}</code></a>{% if qs.runs %} · <a href="index.html#runs-{{ qs.anchor }}">{{ qs.runs | length }} run{{ 's' if qs.runs | length != 1 }}</a>{% endif %}</p>
{% if qs.n_questions is not none %}
<div class="counts">
  {% for label, n in qs.tracks %}<span><strong>{{ n }}</strong> {{ label }}</span>{% endfor %}
</div>
<div class="counts">
  {% for label, n in qs.categories %}<span><strong>{{ n }}</strong> {{ label }}</span>{% endfor %}
</div>
<pre class="run"><code>uv run cbioportal-mcp-qa run --questions-file {{ qs.file }}</code></pre>
{% for q in qs.questions %}
<details class="q" data-set="{{ qs.anchor }}" data-track="{{ q.track }}" data-text="{{ (q.question ~ ' ' ~ q.category ~ ' ' ~ q.study ~ ' ' ~ q.id ~ ' ' ~ (q.history | map(attribute='content') | join(' '))) | lower }}">
  <summary>
    <span class="qid">#{{ q.id }}</span>
    <span class="qtext"><span class="type"><span class="track">{{ track_labels[q.track] }}</span>{{ q.category }} · {{ q.study }}{% if q.history %} · follow-up (turn {{ q.history | length // 2 + 1 }}){% endif %}</span>{{ q.question }}</span>
  </summary>
  <div class="qbody">
    <dl class="ref">
      {% if q.history %}<dt>Conversation so far</dt><dd class="history">{% for t in q.history %}<div class="turn {{ t.role }}"><strong>{{ 'User' if t.role == 'user' else 'Assistant' }}:</strong> {{ t.content }}</div>{% endfor %}</dd>{% endif %}
      {% if q.expected_answer %}<dt>Reference answer{% if q.checked %} <span class="sub">(checked {{ q.checked }})</span>{% endif %}</dt><dd>{{ q.expected_answer }}</dd>{% endif %}
      {% if q.expected_links %}<dt>Expected links</dt><dd>{% for u in q.expected_links %}<a href="{{ u }}">{{ u }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>{% endif %}
      {% if q.notes %}<dt>Notes</dt><dd>{{ q.notes }}</dd>{% endif %}
      {% if q.source and q.source.startswith('http') %}<dt>Source</dt><dd><a href="{{ q.source }}">{{ q.source }}</a></dd>{% endif %}
      {% if not q.has_reference %}<dt>No reference</dt><dd>Not graded until it has an expected answer, link or rubric.</dd>{% endif %}
    </dl>
  </div>
</details>
{% endfor %}
{% else %}
<p class="meta">Could not read <code>{{ qs.file }}</code>.</p>
{% endif %}
</section>
{% endfor %}
</main>
<script>
(() => {
  const text = document.getElementById("q-filter");
  const set = document.getElementById("q-set");
  const track = document.getElementById("q-track");
  const rows = [...document.querySelectorAll("details.q")];
  const sections = [...document.querySelectorAll("section.set")];
  const apply = () => {
    const needle = text.value.trim().toLowerCase();
    for (const row of rows) {
      const hide = (needle && !row.dataset.text.includes(needle))
        || (set.value && row.dataset.set !== set.value)
        || (track.value && row.dataset.track !== track.value);
      row.classList.toggle("hidden", hide);
    }
    for (const s of sections) s.classList.toggle("hidden", Boolean(set.value) && s.dataset.set !== set.value);
  };
  [text, set, track].forEach((el) => el.addEventListener("input", apply));
})();
</script>
</body>
</html>
