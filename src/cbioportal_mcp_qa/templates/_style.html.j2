<style>
:root {
  color-scheme: light;
  --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --grid: #e1e0d9; --axis: #c3c2b7; --ring: rgba(11,11,11,0.10);
  --m-haiku: #2a78d6; --m-sonnet: #eb6834; --m-sonnet-4-6: #1baf7a;
  --o-pass: #0ca30c; --o-fail: #d03b3b; --o-declined: #898781; --o-ungraded: #c3c2b7; --o-error: #52514e;
  --bad-ink: #b42828; --good-ink: #006300;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --axis: #383835; --ring: rgba(255,255,255,0.10);
    --m-haiku: #3987e5; --m-sonnet: #d95926; --m-sonnet-4-6: #199e70;
    --o-ungraded: #52514e; --o-error: #c3c2b7; --bad-ink: #e66767; --good-ink: #0ca30c;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d; --surface: #1a1a19; --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
  --grid: #2c2c2a; --axis: #383835; --ring: rgba(255,255,255,0.10);
  --m-haiku: #3987e5; --m-sonnet: #d95926; --m-sonnet-4-6: #199e70;
  --o-ungraded: #52514e; --o-error: #c3c2b7; --bad-ink: #e66767; --good-ink: #0ca30c;
}
* { box-sizing: border-box; }
body { margin: 0; padding-block: 32px 64px; padding-inline: 16px; background: var(--page); color: var(--ink);
  font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1180px; margin: 0 auto; }
h1 { font-size: 24px; margin: 0 0 4px; }
h2 { font-size: 17px; margin: 40px 0 12px; }
a { color: var(--m-haiku); }
.meta { color: var(--ink-2); margin: 0; }
.meta code { font-size: 12px; }
.card { background: var(--surface); border: 1px solid var(--ring); border-radius: 10px; padding: 16px; }
.note { color: var(--ink-2); font-size: 13px; margin: 8px 0 0; }
.swatch { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: 0; }
.m-haiku { --m: var(--m-haiku); } .m-sonnet { --m: var(--m-sonnet); } .m-sonnet-4-6 { --m: var(--m-sonnet-4-6); }
.swatch.model { background: var(--m); }

.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
.tile h3 { font-size: 13px; font-weight: 600; margin: 0 0 12px; color: var(--ink-2); }
.tile .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 4px 0; }
.tile .value { font-size: 22px; font-weight: 600; }
.tile .sub { color: var(--muted); font-size: 12px; }

.stack { display: flex; height: 22px; gap: 2px; margin: 6px 0; }
.stack span { display: block; height: 100%; min-width: 2px; }
.stack span:first-child { border-radius: 4px 0 0 4px; } .stack span:last-child { border-radius: 0 4px 4px 0; }
.stack span:only-child { border-radius: 4px; }
.o-pass { background: var(--o-pass); } .o-fail { background: var(--o-fail); } .o-declined { background: var(--o-declined); }
.o-ungraded { background: var(--o-ungraded); } .o-error { background: var(--o-error); }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; color: var(--ink-2); font-size: 13px; }
.legend b { color: var(--ink); font-weight: 600; }
.verdict-row { margin-bottom: 16px; }
.verdict-row .name { font-weight: 600; }

.bars { display: grid; grid-template-columns: minmax(140px, 260px) 1fr; gap: 10px 16px; align-items: center; }
.bars .label { font-size: 13px; }
.bars .label .sub { color: var(--muted); font-size: 12px; }
.bar-pair { display: grid; gap: 3px; }
.bar { display: flex; align-items: center; gap: 8px; height: 14px; }
.bar i { display: block; height: 100%; background: var(--m); border-radius: 0 4px 4px 0; min-width: 2px; }
.bar em { font-style: normal; font-size: 12px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.bar.none em { color: var(--muted); }

.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
th, td { text-align: right; padding: 6px 10px; border-bottom: 1px solid var(--grid); white-space: nowrap; }
th:first-child, td:first-child { text-align: left; }
th { color: var(--ink-2); font-weight: 600; font-size: 12px; }
td.bad { color: var(--bad-ink); font-weight: 600; }

.filters { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 12px; }
.filters input[type=search] { font: inherit; padding: 6px 10px; border: 1px solid var(--axis); border-radius: 6px;
  background: var(--surface); color: var(--ink); min-width: 240px; }
details.q { background: var(--surface); border: 1px solid var(--ring); border-radius: 10px; margin-bottom: 8px; }
details.q > summary { list-style: none; cursor: pointer; padding: 10px 14px; display: grid;
  grid-template-columns: 44px 1fr auto; gap: 12px; align-items: center; }
details.q > summary::-webkit-details-marker { display: none; }
.qid { color: var(--muted); font-variant-numeric: tabular-nums; }
.qtext .type { display: block; color: var(--muted); font-size: 12px; }
.badges { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
.badge { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 999px;
  border: 1px solid var(--ring); font-size: 12px; white-space: nowrap; }
.badge .dot { width: 8px; height: 8px; border-radius: 2px; background: var(--m); }
.badge .icon { font-weight: 700; }
.badge.o-pass, .badge.o-fail, .badge.o-declined, .badge.o-ungraded, .badge.o-error { background: none; }
.badge.o-pass .icon { color: var(--good-ink); } .badge.o-fail .icon, .badge.o-error .icon { color: var(--bad-ink); }
.track { display: inline-block; font-size: 11px; padding: 0 6px; border-radius: 4px; border: 1px solid var(--ring); color: var(--ink-2); margin-right: 6px; }
.filters select { font: inherit; padding: 5px 8px; border: 1px solid var(--axis); border-radius: 6px; background: var(--surface); color: var(--ink); }
.qbody { padding: 0 14px 14px; }
.ref { color: var(--ink-2); font-size: 13px; margin-bottom: 12px; }
.ref dt { font-weight: 600; color: var(--ink); margin-top: 6px; }
.ref dd { margin: 0; white-space: pre-wrap; }
.ref dd.history .turn { margin-bottom: 6px; }
.ref dd.history .turn.assistant { color: var(--ink-2); }
.answers { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
.answer { border: 1px solid var(--ring); border-radius: 8px; padding: 10px 12px; border-top: 3px solid var(--m); }
.answer h4 { margin: 0 0 6px; font-size: 13px; display: flex; justify-content: space-between; gap: 8px; }
.answer .stats { color: var(--muted); font-size: 12px; font-weight: 400; }
.answer pre { white-space: pre-wrap; word-break: break-word; font: 13px/1.5 system-ui, sans-serif; margin: 0;
  max-height: 420px; overflow: auto; }
.answer .judge { font-size: 13px; color: var(--ink-2); border-top: 1px solid var(--grid); margin-top: 8px; padding-top: 8px; }
.answer .err { color: var(--bad-ink); font-size: 12px; white-space: pre-wrap; word-break: break-word; }
.shots { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.shots img { width: 280px; max-width: 100%; border: 1px solid var(--ring); border-radius: 6px; display: block; }
.hidden { display: none !important; }
</style>
