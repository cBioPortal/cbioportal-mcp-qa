<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>cBioPortalChat benchmark runs</title>
{% include "_style.html.j2" %}
<style>
th.setup, td.setup { text-align: left; }
td.setup { font-size: 12px; line-height: 1.5; }
td.setup div { white-space: nowrap; padding: 0 4px; border-radius: 3px; }
td.setup code { font-size: 11px; }
td.setup .changed, mark.changed { background: color-mix(in srgb, var(--m-sonnet) 16%, transparent); color: inherit; }
.muted { color: var(--muted); }
table.sets td { vertical-align: top; text-align: left; }
table.sets th { text-align: left; }
table.sets td.purpose { min-width: 360px; white-space: normal; line-height: 1.45; }
table.sets td.tracks div { white-space: nowrap; }
</style>
</head>
<body>
<main>
<h1>cBioPortalChat benchmark runs</h1>
<p class="meta">Each run asks every question and grades the answers pass/fail. The runner is either LibreChat (the deployed agent through its Agents API) or Claude Code (headless, with the agent's prompt and the same MCP servers) — compare runs with the same runner. Each test set has its own table — compare runs within a table, not across. Newest first; <mark class="changed">highlighted</mark> setup values changed since the previous run of the same set that recorded them.</p>
<h2 id="test-sets">Test sets</h2>
<p class="meta">Each questions file is a separate test set with its own purpose; its runs have their own table below.</p>
<div class="card table-wrap" style="margin-top:12px">
<table class="sets">
  <thead><tr><th>Set</th><th>Questions</th><th>Tracks</th><th>Purpose</th><th>Runs</th></tr></thead>
  <tbody>
  {% for qs in question_sets %}
    <tr>
      <td><strong>{{ qs.title }}</strong><br><a href="{{ qs.url }}"><code>{{ qs.file }}</code></a></td>
      <td>{{ qs.n_questions if qs.n_questions is not none else '–' }}</td>
      <td class="tracks">{% for label, n in qs.tracks %}<div>{{ label }} <span class="muted">{{ n }}</span></div>{% endfor %}</td>
      <td class="purpose">{{ qs.purpose }}</td>
      <td>{% if qs.runs %}<a href="#{{ qs.anchor }}">{{ qs.runs | length }}</a>{% else %}0{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% for qs in question_sets if qs.runs %}
<h2 id="{{ qs.anchor }}">{{ qs.title }}</h2>
<p class="meta">{{ qs.short }} Questions: <a href="{{ qs.url }}"><code>{{ qs.file }}</code></a>.</p>
<div class="card table-wrap" style="margin-top:12px">
<table>
  <thead><tr><th>Run</th><th>Target</th><th class="setup">Setup</th><th>Questions</th><th>Model</th><th>Pass rate</th>
    {% for key, label in track_labels.items() %}<th>{{ label }}</th>{% endfor %}
    <th>Cost / correct</th><th>Median latency</th><th>Failed requests</th></tr></thead>
  <tbody>
  {% for r in qs.runs %}{% for key, m in r.models.items() %}
    <tr class="m-{{ key | replace('.', '-') }}">
      {% if loop.first %}<td rowspan="{{ r.models | length }}"><a href="{{ r.run_id }}/report.html">{{ r.run_id }}</a></td>
      <td rowspan="{{ r.models | length }}">{{ r.target }}</td>
      <td rowspan="{{ r.models | length }}" class="setup">
        {%- for key, label in [('runner', ''), ('prompt', 'prompt'), ('cbioportal_mcp', 'cbioportal-mcp'), ('navigator', 'navigator'), ('cbioportal', 'cBioPortal')] %}{% set v = r.setup[key] %}
        {%- if v is not none %}<div{% if key in r.changed %} class="changed"{% endif %}>{% if label %}<span class="muted">{{ label }}</span> {% endif %}
          {%- if key == 'prompt' %}<a href="{{ r.run_id }}/agent-prompt.md"><code>{{ v }}</code></a>{% elif key == 'runner' %}<strong>{{ v }}</strong>{% else %}<code>{{ v }}</code>{% endif %}</div>{% endif %}
        {%- endfor %}</td>
      <td rowspan="{{ r.models | length }}">{{ r.n_questions }} ({{ r.n_gradeable }} graded)</td>{% endif %}
      <td><span class="swatch model"></span>{{ m.label }}</td>
      <td>{{ m.pass_rate | pct }}</td>
      {% for t in track_labels %}<td>{{ (m.by_track or {}).get(t) | pct }}</td>{% endfor %}
      <td>{{ m.cost_per_pass | usd }}</td><td>{{ m.median_latency | secs }}</td><td>{{ m.errors }}</td>
    </tr>
  {% endfor %}{% endfor %}
  </tbody>
</table>
</div>
{% endfor %}
</main>
</body>
</html>
