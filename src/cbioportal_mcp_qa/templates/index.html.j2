<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>cBioPortalChat benchmark runs</title>
{% include "_style.html.j2" %}
<style>
th.setup, td.setup { text-align: left; }
td.setup { font-size: 12px; line-height: 1.5; }
td.setup div { white-space: nowrap; padding: 0 4px; border-radius: 3px; }
td.setup code { font-size: 11px; }
.chg { font-size: 10px; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; color: var(--changed);
  border: 1px solid color-mix(in srgb, var(--changed) 45%, transparent); border-radius: 3px; padding: 0 4px; margin-left: 4px; }
.muted { color: var(--muted); }
nav.pages { display: flex; gap: 16px; margin-bottom: 8px; font-size: 14px; }
nav.pages .current { font-weight: 600; }
</style>
</head>
<body>
<main>
<nav class="pages"><span class="current">Benchmark results</span><a href="test-sets.html">Test sets</a></nav>
<h1>cBioPortalChat benchmark runs</h1>
<p class="meta">Each run asks every question and grades the answers pass/fail. The runner is either LibreChat (the deployed agent through its Agents API) or Claude Code (headless, with the agent's prompt and the same MCP servers) — compare runs with the same runner. Each test set has its own table — compare runs within a table, not across; the <a href="test-sets.html">test sets page</a> describes each set and lists its questions. Newest first.</p>
{% for qs in question_sets if qs.runs %}
<h2 id="runs-{{ qs.anchor }}">{{ qs.title }}</h2>
<p class="meta">{{ qs.short }} <a href="test-sets.html#{{ qs.anchor }}">Questions in this set</a> · <a href="{{ qs.url }}"><code>{{ qs.file }}</code></a></p>
<p class="meta legend"><span class="chg">changed</span> marks a setup value that differs from the run below it in this table (hover for the previous value).</p>
<div class="card table-wrap" style="margin-top:12px">
<table>
  <thead><tr><th>Run</th><th>Target</th><th class="setup">Setup</th><th>Questions</th><th>Model</th><th>Pass rate</th>
    {% for key, label in track_labels.items() %}<th>{{ label }}</th>{% endfor %}
    <th>Cost / correct</th><th>Median latency</th><th>Failed requests</th></tr></thead>
  <tbody>
  {% for r in qs.runs %}{% for key, m in r.models.items() %}
    <tr class="m-{{ key | replace('.', '-') }}">
      {% if loop.first %}<td rowspan="{{ r.models | length }}"><a href="{{ r.run_id }}/report.html">{{ r.run_id }}</a></td>
      <td rowspan="{{ r.models | length }}">{{ r.target }}</td>
      <td rowspan="{{ r.models | length }}" class="setup">
        {%- for key, label in [('runner', ''), ('prompt', 'prompt'), ('cbioportal_mcp', 'cbioportal-mcp'), ('navigator', 'navigator'), ('cbioportal', 'cBioPortal')] %}{% set v = r.setup[key] %}
        {%- if v is not none %}<div{% if key in r.changed %} class="changed" title="Changed since the previous run; was: {{ r.changed[key] }}"{% endif %}>{% if label %}<span class="muted">{{ label }}</span> {% endif %}
          {%- if key == 'prompt' %}<a href="{{ r.run_id }}/agent-prompt.md"><code>{{ v }}</code></a>{% elif key == 'runner' %}<strong>{{ v }}</strong>{% else %}<code>{{ v }}</code>{% endif %}
          {%- if key in r.changed %} <span class="chg">changed</span>{% endif %}</div>{% endif %}
        {%- endfor %}</td>
      <td rowspan="{{ r.models | length }}">{{ r.n_questions }} ({{ r.n_gradeable }} graded)</td>{% endif %}
      <td><span class="swatch model"></span>{{ m.label }}</td>
      <td>{{ m.pass_rate | pct }}</td>
      {% for t in track_labels %}<td>{{ (m.by_track or {}).get(t) | pct }}</td>{% endfor %}
      <td>{{ m.cost_per_pass | usd }}</td><td>{{ m.median_latency | secs }}</td><td>{{ m.errors }}</td>
    </tr>
  {% endfor %}{% endfor %}
  </tbody>
</table>
</div>
{% endfor %}
</main>
</body>
</html>
