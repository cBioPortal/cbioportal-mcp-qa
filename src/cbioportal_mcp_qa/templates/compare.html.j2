{%- set marks = {'better': 'good', 'worse': 'bad', 'same': ''} -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Benchmark comparison {{ r.a.run_id }} vs {{ r.b.run_id }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<main>
<p class="meta"><a href="../../index.html">← All runs</a></p>
<h1>{{ r.a.run_id }} vs {{ r.b.run_id }}</h1>
<p class="meta"><strong>A (baseline)</strong> <a href="../../{{ r.a.run_id }}/report.html">{{ side_name(r.a) }}</a>{% if r.a.agent_id %}, agent <code>{{ r.a.agent_id }}</code>{% endif %}{% if r.a.librechat is string %}, LibreChat <code>{{ r.a.librechat.split(':')[-1] }}</code>{% endif %} · {{ r.a.records }} answers</p>
<p class="meta"><strong>B</strong> <a href="../../{{ r.b.run_id }}/report.html">{{ side_name(r.b) }}</a>{% if r.b.agent_id %}, agent <code>{{ r.b.agent_id }}</code>{% endif %}{% if r.b.librechat is string %}, LibreChat <code>{{ r.b.librechat.split(':')[-1] }}</code>{% endif %} · {{ r.b.records }} answers</p>
<p class="meta">{{ r.n_questions }} questions asked in both runs, repeats pooled{% if r.only_a %} · only in A: {{ r.only_a | join(', ') }}{% endif %}{% if r.only_b %} · only in B: {{ r.only_b | join(', ') }}{% endif %}</p>

<h2>Headline</h2>
<div class="card table-wrap"><table>
  <thead><tr><th>Metric</th><th>A</th><th>B</th><th>Δ (B − A)</th></tr></thead>
  <tbody>
  {% for m in r.metrics %}
    <tr><td>{{ m.label }}</td><td>{{ m.a | fmt(m.fmt) }}</td><td>{{ m.b | fmt(m.fmt) }}</td>
      <td class="{{ marks[m.verdict] }}">{{ m.delta | fmt(m.fmt, true) }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
<p class="note">Per question (pass rate across repeats): <b>{{ r.question_verdicts.better }}</b> better, <b>{{ r.question_verdicts.worse }}</b> worse, {{ r.question_verdicts.same }} same. Green is better for B, red worse. Tool rounds and handoffs are only recorded in traces attached after the per-call trace change.</p>

<h2>Consistency across repeats</h2>
<div class="card table-wrap"><table>
  <thead><tr><th></th><th>A</th><th>B</th></tr></thead>
  <tbody>
    <tr><td>Questions with mixed pass/fail across repeats</td><td>{{ r.a.consistency.flaky }}</td><td>{{ r.b.consistency.flaky }}</td></tr>
    <tr><td>Mean per-question pass variance (0 = always agrees, 0.25 = coin flip)</td><td>{{ r.a.consistency.mean_pass_variance | fmt('num') }}</td><td>{{ r.b.consistency.mean_pass_variance | fmt('num') }}</td></tr>
    <tr><td>Median per-question latency stdev</td><td>{{ r.a.consistency.median_latency_stdev | fmt('secs') }}</td><td>{{ r.b.consistency.median_latency_stdev | fmt('secs') }}</td></tr>
    <tr><td>Routed to</td>
      <td>{% for k, n in r.a.routed_to.items() %}<code>{{ k }}</code> {{ n }}{% if not loop.last %}, {% endif %}{% else %}–{% endfor %}</td>
      <td>{% for k, n in r.b.routed_to.items() %}<code>{{ k }}</code> {{ n }}{% if not loop.last %}, {% endif %}{% else %}–{% endfor %}</td></tr>
  </tbody>
</table></div>

<h2>By category</h2>
<div class="card table-wrap"><table>
  <thead><tr><th>Category</th><th>n A / B</th><th>Pass A</th><th>Pass B</th><th>Δ</th><th>Median latency A</th><th>B</th><th>&lt;10s A</th><th>B</th></tr></thead>
  <tbody>
  {% for c in r.by_category %}
    <tr><td>{{ c.label }}</td><td>{{ c.n.a }} / {{ c.n.b }}</td><td>{{ c.a | fmt('pct') }}</td><td>{{ c.b | fmt('pct') }}</td>
      <td class="{{ 'good' if c.delta and c.delta > 0 else ('bad' if c.delta and c.delta < 0 else '') }}">{{ c.delta | fmt('pct', true) }}</td>
      <td>{{ c.median_latency_a | fmt('secs') }}</td><td>{{ c.median_latency_b | fmt('secs') }}</td>
      <td>{{ c.fast_share_a | fmt('pct') }}</td><td>{{ c.fast_share_b | fmt('pct') }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>

<h2>By track</h2>
<div class="card table-wrap"><table>
  <thead><tr><th>Track</th><th>n A / B</th><th>Pass A</th><th>Pass B</th><th>Δ</th></tr></thead>
  <tbody>
  {% for t in r.by_track %}
    <tr><td>{{ t.label }}</td><td>{{ t.n.a }} / {{ t.n.b }}</td><td>{{ t.a | fmt('pct') }}</td><td>{{ t.b | fmt('pct') }}</td>
      <td class="{{ 'good' if t.delta and t.delta > 0 else ('bad' if t.delta and t.delta < 0 else '') }}">{{ t.delta | fmt('pct', true) }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>

<h2>Per question</h2>
<p class="note">Regressions first, then improvements, then unchanged. ✓ pass · ✗ fail · – declined · · no reference · ! request failed, one mark per repeat.</p>
<div class="card table-wrap"><table>
  <thead><tr><th>Q</th><th>Category</th><th>A</th><th>B</th><th>Δ pass</th><th>Median latency A</th><th>B</th><th>Latency stdev B</th><th>LLM calls A</th><th>B</th><th>Routed to (B)</th><th>Question</th></tr></thead>
  <tbody>
  {% for q in r.questions %}
    <tr><td>{{ q.id }}</td><td>{{ q.category }}</td>
      <td>{{ q.a.icons }} {{ q.a.passes }}/{{ q.a.graded }}</td><td>{{ q.b.icons }} {{ q.b.passes }}/{{ q.b.graded }}</td>
      <td class="{{ marks[q.verdict] }}">{{ q.delta | fmt('pct', true) }}</td>
      <td>{{ q.a.median_latency | fmt('secs') }}</td><td>{{ q.b.median_latency | fmt('secs') }}</td><td>{{ q.b.latency_stdev | fmt('secs') }}</td>
      <td>{{ q.a.mean_llm_calls | fmt('num') }}</td><td>{{ q.b.mean_llm_calls | fmt('num') }}</td>
      <td>{{ q.b.routed_to | join(', ') or '–' }}</td>
      <td class="text">{{ q.question }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
</main>
</body>
</html>
